# Configuración de entorno para Khora — Tu espacio ACT
# Copia este archivo como .env y edita los valores según necesites

NODE_ENV=production
PORT=8084
HOST=0.0.0.0

# Persistencia en Base de Datos SQLite en el servidor (desactivada por defecto).
# Por defecto cada usuario guarda sus datos en local en su móvil/navegador (IndexedDB + LocalStorage).
# Pon ENABLE_SQLITE_DB=true (y descomenta ./data:/app/data en docker-compose.yml) solo para uso personal monousuario en DB.
# ENABLE_SQLITE_DB=true
DB_PATH=/app/data/act.db

# Modo sin caché para desarrollo: no-store en todos los assets y desregistrar el service worker.
# Equivalente a `npm run dev` o `node server/server.js --no-cache`.
# NO_CACHE=true

# Login opcional cuando ENABLE_SQLITE_DB=true para proteger los datos SQLite compartidos:
AUTH_USER=admin
AUTH_PASSWORD=
AUTH_SECRET=
